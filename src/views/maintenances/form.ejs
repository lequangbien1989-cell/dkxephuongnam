<div class="page-title"><%= title %></div>

<div class="card">
  <div class="card-body">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger py-2 small"><%= error %></div>
    <% } %>
    <form method="POST" action="/maintenances<%= maint.id ? '/' + maint.id : '' %>">
      <div class="row g-2 mb-2">
        <div class="col-md-4">
          <label class="form-label small">Xe <span class="text-danger">*</span></label>
          <select name="vehicle_id" class="form-select form-select-sm" required>
            <option value="">-- Chọn xe --</option>
            <% vehicles.forEach(v => { %>
              <option value="<%= v.id %>" <%= maint.vehicle_id == v.id ? 'selected' : '' %>><%= v.plate_number %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small">Ngày bảo dưỡng <span class="text-danger">*</span></label>
          <input type="date" name="maint_date" class="form-control form-control-sm" value="<%= maint.maint_date || today %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label small">Người đi bảo dưỡng <span class="text-danger">*</span></label>
          <select name="driver_name" class="form-select form-select-sm" required>
            <option value="">-- Chọn tài xế --</option>
            <% drivers.forEach(d => { %>
              <option value="<%= d.name %>" <%= maint.driver_name === d.name ? 'selected' : '' %>><%= d.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="row g-2 mb-2">
        <div class="col-md-8">
          <label class="form-label small">Nội dung bảo dưỡng <span class="text-danger">*</span></label>
          <input name="content" class="form-control form-control-sm" value="<%= maint.content || '' %>" placeholder="VD: Thay nhớt, thay lốp, bảo dưỡng định kỳ..." required>
        </div>
        <div class="col-md-4">
          <label class="form-label small">Chi phí (VNĐ)</label>
          <input type="number" name="cost" class="form-control form-control-sm" value="<%= maint.cost || '' %>" placeholder="0">
        </div>
      </div>
      <div class="row g-2 mb-2">
        <div class="col-md-4">
          <label class="form-label small">Số KM lúc bảo dưỡng</label>
          <input type="number" name="km_at_maint" class="form-control form-control-sm" value="<%= maint.km_at_maint || '' %>">
        </div>
        <div class="col-md-8">
          <label class="form-label small">Ghi chú</label>
          <input name="notes" class="form-control form-control-sm" value="<%= maint.notes || '' %>">
        </div>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-save me-1"></i>Lưu</button>
        <a href="/maintenances" class="btn btn-outline-secondary btn-sm">Huỷ</a>
      </div>
    </form>
  </div>
</div>