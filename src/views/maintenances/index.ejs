<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="page-title"><%= title %></div>
  <a href="/maintenances/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm bảo dưỡng</a>
</div>

<!-- Filter -->
<div class="card mb-3">
  <div class="card-body py-2">
    <form class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small">Xe</label>
        <select name="vehicle_id" class="form-select form-select-sm">
          <option value="">Tất cả</option>
          <% vehicles.forEach(v => { %>
            <option value="<%= v.id %>" <%= filter_vehicle == v.id ? 'selected' : '' %>><%= v.plate_number %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-auto">
        <button class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Lọc</button>
        <a href="/maintenances" class="btn btn-outline-secondary btn-sm">Xoá</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 small">
        <thead>
          <tr><th>Ngày</th><th>Xe</th><th>Người đi</th><th>Nội dung</th><th>Chi phí</th><th>KM</th><th></th></tr>
        </thead>
        <tbody>
          <% if (maintenances.length === 0) { %>
            <tr><td colspan="7" class="text-muted text-center py-4">Chưa có phiếu bảo dưỡng nào</td></tr>
          <% } else { %>
            <% maintenances.forEach(m => { %>
              <tr>
                <td><%= fd(m.maint_date) %></td>
                <td class="fw-bold"><%= m.plate_number %></td>
                <td><%= m.driver_name %></td>
                <td><%= m.content %></td>
                <td><%= m.cost ? m.cost.toLocaleString() + ' đ' : '-' %></td>
                <td><%= m.km_at_maint ? m.km_at_maint.toLocaleString() : '-' %></td>
                <td class="text-nowrap">
                  <a href="/maintenances/<%= m.id %>/edit" class="btn btn-outline-secondary btn-sm py-0"><i class="bi bi-pencil"></i></a>
                  <form method="POST" action="/maintenances/<%= m.id %>/delete" class="d-inline" onsubmit="return confirm('Xoá phiếu bảo dưỡng?')">
                    <button class="btn btn-outline-danger btn-sm py-0"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>