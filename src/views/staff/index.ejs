<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="page-title"><%= title %></div>
  <a href="/staff/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm nhân sự</a>
</div>

<div class="card mb-3">
  <div class="card-body py-2">
    <form class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small">Vai trò</label>
        <select name="role" class="form-select form-select-sm">
          <option value="">Tất cả</option>
          <% roles.forEach(r => { %>
            <option value="<%= r %>" <%= filterRole === r ? 'selected' : '' %>><%= r %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-auto">
        <button class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Lọc</button>
        <a href="/staff" class="btn btn-outline-secondary btn-sm">Xoá</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 small">
        <thead>
          <tr><th>STT</th><th>Vai trò</th><th>Tên</th><th>Điện thoại</th><th></th></tr>
        </thead>
        <tbody>
          <% if (staff.length === 0) { %>
            <tr><td colspan="5" class="text-muted text-center py-4">Chưa có Admin/NVKD nào</td></tr>
          <% } else { %>
            <% staff.forEach((p, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><span class="badge <%= p.role === 'Admin' ? 'badge-warning' : 'badge-safe' %>"><%= p.role %></span></td>
                <td class="fw-bold"><%= p.name %></td>
                <td><%= p.phone || '-' %></td>
                <td class="text-nowrap">
                  <a href="/staff/<%= p.id %>/edit" class="btn btn-outline-secondary btn-sm py-0"><i class="bi bi-pencil"></i></a>
                  <form method="POST" action="/staff/<%= p.id %>/delete" class="d-inline" onsubmit="return confirm('Xoá <%= p.name %>?')">
                    <button class="btn btn-outline-danger btn-sm py-0"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
