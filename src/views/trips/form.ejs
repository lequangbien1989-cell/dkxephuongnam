<div class="page-title"><%= title %></div>

<div class="card">
  <div class="card-body">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger py-2 small"><%= error %></div>
    <% } %>
    <% if (typeof conflict !== 'undefined' && conflict) { %>
      <div class="alert alert-warning py-2 small"><%= conflict %></div>
    <% } %>
    <form method="POST" action="/trips<%= trip.id ? '/' + trip.id : '' %>">
      <div class="row g-2 mb-2">
        <div class="col-md-3">
          <label class="form-label small">Ngày <span class="text-danger">*</span></label>
          <input type="date" name="trip_date" class="form-control form-control-sm" value="<%= trip.trip_date || today %>" required>
        </div>
        <div class="col-md-3">
          <label class="form-label small">Xe <span class="text-danger">*</span></label>
          <select name="vehicle_id" class="form-select form-select-sm" required>
            <option value="">-- Chọn xe --</option>
            <% vehicles.forEach(v => { %>
              <option value="<%= v.id %>" <%= trip.vehicle_id == v.id ? 'selected' : '' %>><%= v.plate_number %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small">Tài xế <span class="text-danger">*</span></label>
          <select name="driver_name" class="form-select form-select-sm" required>
            <option value="">-- Chọn tài xế --</option>
            <% drivers.forEach(d => { %>
              <option value="<%= d.name %>" <%= trip.driver_name === d.name ? 'selected' : '' %>><%= d.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small">Khung giờ <span class="text-danger">*</span></label>
          <select name="time_range" class="form-select form-select-sm" required>
            <option value="">-- Chọn giờ --</option>
            <option value="7h-17h" <%= trip.time_range === '7h-17h' ? 'selected' : '' %>>7h - 17h (Cả ngày)</option>
            <option value="7h-12h" <%= trip.time_range === '7h-12h' ? 'selected' : '' %>>7h - 12h (Sáng)</option>
            <option value="12h-17h" <%= trip.time_range === '12h-17h' ? 'selected' : '' %>>12h - 17h (Chiều)</option>
          </select>
        </div>
      </div>
      <div class="row g-2 mb-2">
        <div class="col-md-4">
          <label class="form-label small">Nơi đến</label>
          <input name="destination" class="form-control form-control-sm" value="<%= trip.destination || '' %>" placeholder="VD: Bình Dương">
        </div>
        <div class="col-md-4">
          <label class="form-label small">Số km</label>
          <input type="number" name="km_reading" class="form-control form-control-sm" value="<%= trip.km_reading || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label small">Ghi chú</label>
          <input name="notes" class="form-control form-control-sm" value="<%= trip.notes || '' %>">
        </div>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-save me-1"></i>Lưu</button>
        <a href="/trips" class="btn btn-outline-secondary btn-sm">Huỷ</a>
      </div>
    </form>
  </div>
</div>
