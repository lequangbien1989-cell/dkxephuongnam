<div class="page-title"><%= title %></div>

<div class="card">
  <div class="card-body">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger py-2 small"><%= error %></div>
    <% } %>
    <form method="POST" action="/vehicles<%= vehicle.id ? '/' + vehicle.id : '' %>">
      <% if (vehicle.id) { %><input type="hidden" name="_method" value="PUT"><% } %>
      <div class="row g-2 mb-2">
        <div class="col-md-4">
          <label class="form-label small">Biển số <span class="text-danger">*</span></label>
          <input name="plate_number" class="form-control form-control-sm" value="<%= vehicle.plate_number || '' %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label small">Điện thoại</label>
          <input name="phone" class="form-control form-control-sm" value="<%= vehicle.phone || '' %>" placeholder="0932xxx (tên)">
        </div>
        <div class="col-md-4">
          <label class="form-label small">KM bảo dưỡng</label>
          <input type="number" name="maintenance_km" class="form-control form-control-sm" value="<%= vehicle.maintenance_km || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label small">KM hiện tại</label>
          <input type="number" name="current_km" class="form-control form-control-sm" value="<%= vehicle.current_km || '' %>">
        </div>
      </div>
      <div class="row g-2 mb-2">
        <div class="col-md-4">
          <label class="form-label small">Hạn đăng kiểm</label>
          <input type="date" name="registration_expiry" class="form-control form-control-sm" value="<%= vehicle.registration_expiry || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label small">Hạn bảo hiểm</label>
          <input type="date" name="insurance_expiry" class="form-control form-control-sm" value="<%= vehicle.insurance_expiry || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label small">Hạn BH thân vỏ</label>
          <input type="date" name="body_insurance_expiry" class="form-control form-control-sm" value="<%= vehicle.body_insurance_expiry || '' %>">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label small">Ghi chú</label>
        <textarea name="notes" class="form-control form-control-sm" rows="2"><%= vehicle.notes || '' %></textarea>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-save me-1"></i>Lưu</button>
        <a href="/vehicles" class="btn btn-outline-secondary btn-sm">Huỷ</a>
      </div>
    </form>
  </div>
</div>
