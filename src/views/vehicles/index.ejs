<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="page-title"><%= title %></div>
  <a href="/vehicles/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm xe</a>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 small">
        <thead>
          <tr><th>Biển số</th><th>Điện thoại</th><th>Đăng kiểm</th><th>Bảo hiểm</th><th>BH Thân vỏ</th><th>KM hiện tại</th><th>KM bảo dưỡng</th><th>Ghi chú</th><th></th></tr>
        </thead>
        <tbody>
          <% vehicles.forEach(v => { %>
            <tr>
              <td class="fw-bold"><% var _vi4 = vi(v.vehicle_type); %><img src="<%= _vi4.img %>" alt="<%= _vi4.label %>" title="<%= _vi4.label %>" class="brand-logo"> <a href="/vehicles/<%= v.id %>"><%= v.plate_number %></a></td>
              <td><%= v.phone || '-' %></td>
              <td>
                <% if (v.registration_expiry) { var d = du(v.registration_expiry); var cls = d<=0?'badge-expired':d<=15?'badge-warning':'badge-safe'; %>
                  <span class="badge <%= cls %>"><%= fd(v.registration_expiry) %></span>
                <% } else { %>--<% } %>
              </td>
              <td>
                <% if (v.insurance_expiry) { var d = du(v.insurance_expiry); var cls = d<=0?'badge-expired':d<=15?'badge-warning':'badge-safe'; %>
                  <span class="badge <%= cls %>"><%= fd(v.insurance_expiry) %></span>
                <% } else { %>--<% } %>
              </td>
              <td>
                <% if (v.body_insurance_expiry) { var d = du(v.body_insurance_expiry); var cls = d<=0?'badge-expired':d<=15?'badge-warning':'badge-safe'; %>
                  <span class="badge <%= cls %>"><%= fd(v.body_insurance_expiry) %></span>
                <% } else { %>--<% } %>
              </td>
              <td><%= v.current_km ? v.current_km.toLocaleString() + ' km' : '--' %></td>
              <td><%= v.maintenance_km ? v.maintenance_km.toLocaleString() + ' km' : '--' %></td>
              <td class="text-truncate" style="max-width:150px"><%= v.notes || '' %></td>
              <td class="text-nowrap">
                <button type="button" onclick="checkPhatNguoi('<%= v.plate_number %>')" title="Tra phạt nguội <%= v.plate_number %>" class="btn btn-outline-danger btn-sm py-0"><i class="bi bi-shield-exclamation me-1"></i>Check phạt nguội</button>
                <a href="/vehicles/<%= v.id %>/edit" class="btn btn-outline-secondary btn-sm py-0"><i class="bi bi-pencil"></i></a>
                <form method="POST" action="/vehicles/<%= v.id %>/delete" class="d-inline" onsubmit="return confirm('Xoá xe <%= v.plate_number %>?')">
                  <button class="btn btn-outline-danger btn-sm py-0"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
