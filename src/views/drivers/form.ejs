<div class="page-title"><%= title %></div>

<div class="card">
  <div class="card-body">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger py-2 small"><%= error %></div>
    <% } %>
    <form method="POST" action="/drivers<%= driver.id ? '/' + driver.id : '' %>">
      <div class="row g-2 mb-2">
        <div class="col-md-6">
          <label class="form-label small">Tên tài xế <span class="text-danger">*</span></label>
          <input name="name" class="form-control form-control-sm" value="<%= driver.name || '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label small">Điện thoại</label>
          <input name="phone" class="form-control form-control-sm" value="<%= driver.phone || '' %>">
        </div>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-save me-1"></i>Lưu</button>
        <a href="/drivers" class="btn btn-outline-secondary btn-sm">Huỷ</a>
      </div>
    </form>
  </div>
</div>
