<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="page-title"><%= title %></div>
  <a href="/drivers/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm tài xế</a>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 small">
        <thead>
          <tr><th>STT</th><th>Tên</th><th>Điện thoại</th><th></th></tr>
        </thead>
        <tbody>
          <% drivers.forEach((d, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td class="fw-bold"><%= d.name %></td>
              <td><%= d.phone || '-' %></td>
              <td class="text-nowrap">
                <a href="/drivers/<%= d.id %>/edit" class="btn btn-outline-secondary btn-sm py-0"><i class="bi bi-pencil"></i></a>
                <form method="POST" action="/drivers/<%= d.id %>/delete" class="d-inline" onsubmit="return confirm('Xoá tài xế <%= d.name %>?')">
                  <button class="btn btn-outline-danger btn-sm py-0"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
