<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Quản lý Xe Phương Nam</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #f5f6fa; font-size: .9rem; }
    .sidebar { width: 220px; position: fixed; top: 0; left: 0; bottom: 0; background: #2c3e50; padding-top: 56px; overflow-y: auto; z-index: 100; }
    .sidebar .nav-link { color: #bdc3c7; padding: 10px 20px; border-radius: 0; transition: .2s; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: #34495e; }
    .sidebar .nav-link i { margin-right: 8px; width: 20px; text-align: center; }
    .wrapper { margin-left: 220px; min-height: 100vh; }
    .navbar-top { height: 56px; background: #fff; border-bottom: 1px solid #dee2e6; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; }
    .main-content { padding: 20px 24px; }
    .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 16px; }
    .card-header { background: #fff; border-bottom: 1px solid #eee; font-weight: 600; padding: 12px 20px; }
    .badge-expired { background: #e74c3c; color: #fff; }
    .badge-warning { background: #f39c12; color: #fff; }
    .badge-safe { background: #27ae60; color: #fff; }
    .stat-card { text-align: center; padding: 20px; }
    .stat-card .number { font-size: 2rem; font-weight: 700; }
    .stat-card .label { color: #7f8c8d; font-size: .85rem; }
    .vehicle-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }
    .table th { background: #f8f9fa; white-space: nowrap; }
    .page-title { font-size: 1.25rem; font-weight: 600; margin-bottom: 16px; }
    .btn-sm { font-size: .8rem; }
    @media (max-width: 768px) {
      .sidebar { width: 50px; }
      .sidebar .nav-link span { display: none; }
      .sidebar .nav-link i { margin-right: 0; }
      .main-content { margin-left: 50px; }
      .wrapper { margin-left: 50px; }
      .navbar-top { left: 50px; }
    }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar">
    <div class="px-3 py-2" style="text-align:center">
      <img src="/logo.png" alt="Phương Nam" style="max-width:130px;height:auto;">
    </div>
    <nav class="nav flex-column">
      <a class="nav-link" href="/"><i class="bi bi-speedometer2"></i><span>Tổng quan</span></a>
      <a class="nav-link" href="/vehicles"><i class="bi bi-truck"></i><span>Xe</span></a>
      <a class="nav-link" href="/drivers"><i class="bi bi-people"></i><span>Tài xế</span></a>
      <a class="nav-link" href="/trips"><i class="bi bi-calendar-week"></i><span>Chuyến đi</span></a>
      <a class="nav-link" href="/maintenances"><i class="bi bi-tools"></i><span>Bảo dưỡng</span></a>
      <a class="nav-link" href="/company"><i class="bi bi-building"></i><span>Công ty</span></a>
    </nav>
  </div>

  <!-- Top navbar -->
  <div class="navbar-top">
    <span class="fw-semibold"><%= typeof title !== 'undefined' ? title : 'Tổng quan' %></span>
    <div></div>
  </div>

  <!-- Main content -->
  <div class="wrapper">
    <div class="main-content">
      <%- body %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Highlight active nav link
    document.querySelectorAll('.sidebar .nav-link').forEach(a => {
      if (a.getAttribute('href') === window.location.pathname) a.classList.add('active');
    });
  </script>
</body>
</html>
